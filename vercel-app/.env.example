# Copy this file to `.env` and fill in the real value.
#   cp .env.example .env
#
# `.env` is git-ignored so the secret never gets committed.
#
# NOTE: This local .env is only read by `vercel dev` for local testing.
# The DEPLOYED Vercel function reads env vars from the Vercel project
# settings instead — set it there with:
#   npx vercel env add OLLAMA_API_KEY
# or in the dashboard: Project → Settings → Environment Variables.

# Ollama Cloud API key — used by api/generate.py for LLM code generation.
# Get one at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
